<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header / Barra Superiore (Sempre visibile in alto) -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Icona App"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF Unifier Pro"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical">

            <!-- Pulsante Cronologia -->
            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_recent_history"
                android:contentDescription="Cronologia"
                android:layout_marginEnd="12dp"/>

            <!-- Pulsante Info -->
            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="Info" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Selettore Modalità a 3 Schede (Spazia su tutta la larghezza) -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/headerLayout"
        android:layout_marginBottom="24dp"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/tabMerge"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Unisci"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#2C2C2C"/>

        <Button
            android:id="@+id/tabImageToPdf"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Immagini"
            android:textColor="#888888"
            android:textSize="14sp"
            android:backgroundTint="#1E1E1E"/>

        <Button
            android:id="@+id/tabSplit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Dividi"
            android:textColor="#888888"
            android:textSize="14sp"
            android:backgroundTint="#1E1E1E"/>
    </LinearLayout>

    <!-- AREA PRINCIPALE A DUE COLONNE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTabs"
        android:layout_above="@id/adView"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2">

        <!-- ==================== COLONNA DI SINISTRA (Azioni e Opzioni) ==================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <!-- Card d'Avviso / Logo Centrale Rimpicciolito -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:background="#1E1E1E"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgCenterIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_input_add"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:backgroundTint="#1B5E20"
                    android:padding="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unisci i tuoi PDF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/txtSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unisci più file PDF localmente e offline."
                        android:textSize="12sp"
                        android:textColor="#B0BEC5"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Pulsante Principale di Inserimento -->
            <Button
                android:id="@+id/btnAddFiles"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="+ Aggiungi PDF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#121212"
                android:backgroundTint="#A5D6A7"
                android:layout_marginBottom="20dp" />

            <!-- Opzioni di Divisione (Nascosto di base) -->
            <LinearLayout
                android:id="@+id/cardSplitOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:background="#1E1E1E"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intervallo di estrazione"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtTotalPages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carica un PDF per vedere le pagine disponibili"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Da:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/edtStartPage"
                        android:layout_width="70dp"
                        android:layout_height="48dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#2C2C2C"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:inputType="number"
                        android:text="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/edtEndPage"
                        android:layout_width="70dp"
                        android:layout_height="48dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#2C2C2C"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:inputType="number"
                        android:text="1"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Opzione di Compressione -->
            <LinearLayout
                android:id="@+id/cardCompress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#1E1E1E"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblCompressTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compressione PDF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblCompressSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Riduci le dimensioni del file finale"
                        android:textColor="#B0BEC5"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchCompress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== COLONNA DI DESTRA (Lista File e Salvataggio) ==================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/lblDocumentiSelezionati"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Documenti selezionati (0):"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnClearList"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:text="Svuota Lista"
                    android:textColor="#E53935"
                    android:textSize="12sp" />
            </RelativeLayout>

            <!-- Contenitore con lista a scorrimento -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                android:background="#1E1E1E">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtFileListPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:padding="24dp"
                            android:text="Nessun file selezionato.\nAggiungi almeno due PDF per unirli."
                            android:textColor="#B0BEC5"
                            android:textSize="14sp"
                            android:textAlignment="center"
                            android:lineSpacingExtra="4dp"/>

                        <LinearLayout
                            android:id="@+id/containerFileList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"/>
                    </RelativeLayout>
                </ScrollView>
            </FrameLayout>

            <!-- Pulsanti d'Azione Finali (Affiancati) -->
            <LinearLayout
                android:id="@+id/layoutMergeActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnMergeSave"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:text="Unisci e Salva"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#80FFFFFF"
                    android:backgroundTint="#2C2C2C"
                    android:layout_marginEnd="8dp"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btnMergeShare"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:text="Unisci e Condividi"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#80FFFFFF"
                    android:backgroundTint="#2C2C2C"
                    android:layout_marginStart="8dp"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Banner AdMob (Centrato in fondo) -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111"/>

</RelativeLayout>
